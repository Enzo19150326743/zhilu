APP_ENV=local
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000

# OpenAI-compatible AI API. Copy this file to .env and fill only your own key.
AI_PROVIDER=deepseek
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-v4-pro
AI_FAST_MODEL=deepseek-v4-flash
AI_THINKING_MODEL=deepseek-v4-pro
AI_MAX_TOKENS=8192
AI_QA_MAX_TOKENS=2048
AI_THINKING_TYPE=disabled
AI_REASONING_EFFORT=high

PARSE_RATE_LIMIT_PER_HOUR=20
SUMMARY_RATE_LIMIT_PER_HOUR=10
QA_RATE_LIMIT_PER_HOUR=10
TRANSCRIBE_RATE_LIMIT_PER_HOUR=3

# Optional local download and public-platform settings.
YTDLP_ENABLE_COOKIE_OPTIONS=0
YTDLP_COOKIE_FILE=
YTDLP_COOKIES_FROM_BROWSER=
YTDLP_DOWNLOAD_DIR=
YTDLP_MERGE_OUTPUT_FORMAT=mp4
BILIBILI_ENABLE_COOKIE_OPTIONS=0
BILIBILI_COOKIE_FILE=
FFMPEG_LOCATION=
XIAOYUZHOU_RSSHUB_BASE_URL=https://rsshub.app

# Optional Obsidian export. Disabled by default.
OBSIDIAN_ENABLE_VAULT_WRITE=0
OBSIDIAN_VAULT_DIR=
OBSIDIAN_EXPORT_SUBDIR=知录知识稿

# Local ASR. CPU fallback remains available without NVIDIA/CUDA.
ASR_WHISPER_MODEL=large-v3-turbo
ASR_FALLBACK_WHISPER_MODEL=base
ASR_DEVICE=auto
ASR_COMPUTE_TYPE=int8
ASR_LANGUAGE=zh
ASR_BEAM_SIZE=5
ASR_AUTO_FALLBACK=1
ASR_WHISPER_SEGMENT_NORMALIZATION_ENABLED=1
ASR_WHISPER_SEGMENT_MAX_SECONDS=8
ASR_WHISPER_SEGMENT_MAX_CHARACTERS=120
ASR_WHISPER_SEGMENT_SILENCE_GAP_SECONDS=2

# 可选：第二条本地 ASR 路径。auto 会优先尝试 CUDA，失败后使用 CPU。
SENSEVOICE_MODEL=iic/SenseVoiceSmall
SENSEVOICE_DEVICE=auto
SENSEVOICE_GPU_BATCH_SIZE_SECONDS=60
SENSEVOICE_CPU_BATCH_SIZE_SECONDS=300
SENSEVOICE_SEGMENT_NORMALIZATION_ENABLED=1
SENSEVOICE_SEGMENT_MIN_SENTENCE_SECONDS=4
SENSEVOICE_SEGMENT_MAX_SECONDS=8
SENSEVOICE_SEGMENT_MAX_CHARACTERS=120
SENSEVOICE_SEGMENT_SILENCE_GAP_SECONDS=2

# AI correction is skipped safely when AI_API_KEY is empty.
ASR_CORRECTION_ENABLED=1
AI_CORRECTION_MODEL=deepseek-v4-flash
ASR_CORRECTION_MAX_TOKENS=8192
# This is a per-request correction batch size, not a transcript read limit.
ASR_CORRECTION_CHUNK_CHARS=3500
ASR_CORRECTION_TIMEOUT_SECONDS=120
